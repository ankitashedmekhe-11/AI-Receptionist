<?xml version="1.0" encoding="utf-8"?>
<!-- AI Receptionist — Creative Call Screen UI -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A12">

    <!-- ── Ambient gradient glow (top) ─────────────────────────────────── -->
    <View
        android:id="@+id/ambientGlow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/glow_circle"
        android:alpha="0.18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-80dp" />

    <!-- ── Top bar: backend status pill ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/pill_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="20dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_idle"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvConnectionState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- ── Settings icon ──────────────────────────────────────────────── -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/pill_dark"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="#8892A4"
        android:contentDescription="Settings"
        android:padding="9dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="52dp"
        android:layout_marginStart="20dp" />

    <!-- ── Avatar ring + AI icon ──────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="110dp">

        <!-- Pulse ring (animated via code) -->
        <View
            android:id="@+id/pulseRing"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/ring_pulse"
            android:layout_gravity="center" />

        <!-- Avatar circle -->
        <View
            android:id="@+id/avatarCircle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/avatar_circle"
            android:layout_gravity="center" />

        <!-- Mic icon inside avatar -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:layout_gravity="center"
            android:alpha="0.9" />

    </FrameLayout>

    <!-- ── App name ────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Receptionist"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp" />

    <!-- ── Live status label ───────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to connect"
        android:textColor="#5B8DEF"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.03"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />

    <!-- ── Call timer ──────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#3D4A5C"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.08"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- ── Transcript chat card ────────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTranscript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#0C1018"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCallTimer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- Chat header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="#0F1520">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_active"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE TRANSCRIPT"
                    android:textColor="#3D4A5C"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvMsgCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 messages"
                    android:textColor="#252E3D"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0F1824" />

            <!-- Scrollable message list -->
            <ScrollView
                android:id="@+id/scrollTranscript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbarStyle="insideOverlay"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/chatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Hint text (hidden when messages arrive) -->
                    <TextView
                        android:id="@+id/tvTranscriptHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Conversation will appear here after you connect and start speaking…"
                        android:textColor="#1E2A3A"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingTop="32dp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ── Bottom action bar ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="36dp"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mute button (idle: hidden) -->
        <FrameLayout
            android:id="@+id/btnMuteWrap"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="invisible"
            android:layout_marginEnd="24dp">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_secondary_circle" />

            <ImageView
                android:id="@+id/iconMute"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:tint="#8892A4"
                android:layout_gravity="center"
                android:contentDescription="Mute" />

        </FrameLayout>

        <!-- Primary call button (big) -->
        <FrameLayout
            android:id="@+id/btnCallWrap"
            android:layout_width="72dp"
            android:layout_height="72dp">

            <View
                android:id="@+id/btnCallBg"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/btn_call_green" />

            <ImageView
                android:id="@+id/iconCall"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_call"
                android:tint="#FFFFFF"
                android:layout_gravity="center"
                android:contentDescription="Call" />

            <!-- Invisible touch target -->
            <View
                android:id="@+id/btnCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- End call button (idle: hidden, active: shown) -->
        <FrameLayout
            android:id="@+id/btnEndWrap"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="invisible"
            android:layout_marginStart="24dp">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_end_circle" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"
                android:layout_gravity="center"
                android:contentDescription="End call" />

            <View
                android:id="@+id/btnEndCall"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
